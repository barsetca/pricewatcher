# ============================================================
# PRICEWATCH - CONFIGURATION
# ============================================================
# Copy this file to .env and fill in real values. Never commit .env.
# REQUIRED for Telegram polling; no default. Create the token with @BotFather.
# Example format: 123456789:AAExampleTokenReplaceMe
TELEGRAM_BOT_TOKEN=
# REQUIRED; no default. Comma-separated positive Telegram user IDs; usernames/chat IDs do not work.
# Example: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=
# Optional; only polling is supported. Default: polling.
TELEGRAM_MODE=polling
# Optional local path. Default/example: data/pricewatch.db. Compose overrides it with /data/pricewatch.db.
PRICEWATCH_DATABASE_PATH=data/pricewatch.db
# Optional: DEBUG, INFO, WARNING or ERROR. Default/example: INFO.
PRICEWATCH_LOG_LEVEL=INFO
