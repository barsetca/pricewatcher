#!/usr/sbin/nft -f
# Вносится администратором через nft -f; не заменяет глобальный ruleset.
# Bridge и subnet обязаны совпадать с compose.yaml: pw-egress0, 172.30.0.0/24.
table inet pricewatch_egress {
  set blocked_v4 { type ipv4_addr; flags interval; elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.88.99.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 } }
  set blocked_v6 { type ipv6_addr; flags interval; elements = { ::/128, ::1/128, ::ffff:0:0/96, 64:ff9b:1::/48, 100::/64, 2001::/23, 2001:2::/48, 2001:10::/28, 2001:20::/28, 2001:db8::/32, 2002::/16, 3fff::/20, fc00::/7, fe80::/10, ff00::/8 } }

  chain forward {
    type filter hook forward priority filter; policy accept;
    iifname "pw-egress0" ip daddr @blocked_v4 counter comment "pricewatch-forward-v4-block" reject
    iifname "pw-egress0" ip6 daddr @blocked_v6 counter comment "pricewatch-forward-v6-block" reject
  }

  chain input {
    type filter hook input priority filter; policy accept;
    # Контейнер не обращается к сервисам Docker host/gateway через INPUT.
    iifname "pw-egress0" counter comment "pricewatch-input-host-block" reject
  }
}
